/* ====================================================================
 *  PARTE 8: HILOS (portable) - solo para la parte B
 * ==================================================================== */
#ifdef _WIN32
  typedef HANDLE Hilo;
  #define HILO_FUNCION(nombre)  DWORD WINAPI nombre(LPVOID arg)
  #define HILO_FIN              return 0
  static void hilo_crear(Hilo *h, LPTHREAD_START_ROUTINE f, void *arg)
  { *h = CreateThread(NULL, 0, f, arg, 0, NULL); }
  static void hilo_esperar(Hilo h)
  { WaitForSingleObject(h, INFINITE); CloseHandle(h); }
#else
  typedef pthread_t Hilo;
  #define HILO_FUNCION(nombre)  void *nombre(void *arg)
  #define HILO_FIN              return NULL
  static void hilo_crear(Hilo *h, void *(*f)(void *), void *arg)
  { pthread_create(h, NULL, f, arg); }
  static void hilo_esperar(Hilo h)
  { pthread_join(h, NULL); }
#endif

#define N_HILOS        4
#define CLAVES_X_HILO  2500

static ArbolRN *g_arbol;
static Atomico g_busq_ok;          /* contadores atomicos globales */
static Atomico g_ins_ok;
static Atomico g_elim_ok;

/* log2 sin usar math.h (para no necesitar -lm) */
static double mi_log2(double x)
{
    int e = 0, i;
    double f = 0, b = 0.5;
    while (x >= 2) { x /= 2; e++; }
    for (i = 0; i < 30; i++) { x = x * x; if (x >= 2) { x /= 2; f += b; } b /= 2; }
    return e + f;
}

/* Cada hilo trabaja con su propio rango de claves: id*10000 + k */
static HILO_FUNCION(trabajo)
{
    int id = *(int *)arg;
    int base = id * 10000;
    int k;
    for (k = 0; k < CLAVES_X_HILO; k++)                 /* inserta   */
        if (rn_insertar(g_arbol, base + k)) AT_SUMAR(&g_ins_ok, 1);
    for (k = 0; k < CLAVES_X_HILO; k++)                 /* busca     */
        if (rn_buscar(g_arbol, base + k)) AT_SUMAR(&g_busq_ok, 1);
    for (k = 0; k < CLAVES_X_HILO; k += 2)              /* elimina pares */
        if (rn_eliminar(g_arbol, base + k)) AT_SUMAR(&g_elim_ok, 1);
    HILO_FIN;
}

/* ====================================================================
 *  PROGRAMA PRINCIPAL - PREGUNTA 3
 *  Parte A: eliminar 30 (caso 4).  Parte B: 4 hilos con mutex y atomic.
 * ==================================================================== */
int main(void)
{
    const char *motivo;
    ArbolRN *t;
    int base[5];
    int i, rot0, n, h, esperado, ok;
    Hilo hilos[N_HILOS];
    int ids[N_HILOS];

    /* ---------- Parte A ---------- */
    printf("=== PREGUNTA 3 - Parte A: eliminar 30 ===\n");
    t = rn_crear();
    base[0] = 10; base[1] = 20; base[2] = 30; base[3] = 15; base[4] = 17;
    for (i = 0; i < 5; i++) rn_insertar(t, base[i]);
    printf("\nArbol antes de eliminar:\n");
    rn_imprimir(t);
    printf("\n> Eliminar 30\n");
    t->verbose = 1;
    rot0 = AT_LEER(&t->n_rotaciones);
    rn_eliminar(t, 30);
    printf("\nArbol despues de eliminar:\n");
    rn_imprimir(t);
    printf("Rotaciones en la eliminacion: %d\n", AT_LEER(&t->n_rotaciones) - rot0);
    printf("Altura negra (bh)           : %d\n", rn_altura_negra(t));
    rn_validar(t, &motivo);
    printf("Validacion                  : %s\n", motivo);
    rn_destruir(t);

    /* ---------- Parte B ---------- */
    printf("\n=== PREGUNTA 3 - Parte B: %d hilos con mutex y atomic ===\n", N_HILOS);
    g_arbol = rn_crear();
    AT_INIT(&g_busq_ok, 0); AT_INIT(&g_ins_ok, 0); AT_INIT(&g_elim_ok, 0);

    for (i = 0; i < N_HILOS; i++) { ids[i] = i; hilo_crear(&hilos[i], trabajo, &ids[i]); }
    for (i = 0; i < N_HILOS; i++) hilo_esperar(hilos[i]);

    esperado = N_HILOS * (CLAVES_X_HILO / 2);
    n = AT_LEER(&g_arbol->total_nodos);
    h = rn_altura(g_arbol);
    printf("Inserciones exitosas   : %d (esperadas %d)\n", AT_LEER(&g_ins_ok), N_HILOS * CLAVES_X_HILO);
    printf("Busquedas exitosas     : %d (esperadas %d)\n", AT_LEER(&g_busq_ok), N_HILOS * CLAVES_X_HILO);
    printf("Eliminaciones exitosas : %d (esperadas %d)\n", AT_LEER(&g_elim_ok), N_HILOS * CLAVES_X_HILO / 2);
    printf("Nodos finales (atomic) : %d (esperados %d)\n", n, esperado);
    printf("Altura h               : %d   (cota 2*log2(n+1) = %.1f)\n", h, mi_log2(n + 1.0) * 2);
    printf("Altura negra bh        : %d\n", rn_altura_negra(g_arbol));
    printf("Rotaciones / cambios de color: %d / %d\n",
           AT_LEER(&g_arbol->n_rotaciones), AT_LEER(&g_arbol->n_recoloraciones));
    ok = rn_validar(g_arbol, &motivo);
    printf("Validacion             : %s\n", motivo);
    printf("Resultado              : %s\n", (ok && n == esperado) ? "CORRECTO" : "ERROR");

    rn_destruir(g_arbol);
    pausa();
    return 0;
}
