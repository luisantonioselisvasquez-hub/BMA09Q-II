#define _POSIX_C_SOURCE 200809L
#define __USE_MINGW_ANSI_STDIO 1
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <stdint.h>
#include <pthread.h>
#include <stdatomic.h>

typedef struct Node {
    char *key;
    int value;
    struct Node *next;
} Node;

typedef struct {
    Node **buckets;
    pthread_mutex_t *bucket_locks; /* Exclusión mutua granular por cubeta */
    size_t capacity;
    atomic_size_t size;            /* Contador atómico de elementos activos */
    atomic_size_t collisions;      /* Contador atómico de colisiones ocurridas */
} ConcurrentChainingHashTable;

static size_t hash_str(const char *str, size_t m) {
    uint64_t hash = 5381;
    int c;
    while ((c = (unsigned char)*str++)) {
        hash = ((hash << 5) + hash) + (uint64_t)c;
    }
    return (size_t)(hash % m);
}

ConcurrentChainingHashTable *ht_create(size_t capacity) {
    ConcurrentChainingHashTable *ht;
    size_t i;

    ht = malloc(sizeof(ConcurrentChainingHashTable));
    if (!ht) return NULL;

    ht->capacity = capacity;
    ht->buckets = calloc(capacity, sizeof(Node *));
    ht->bucket_locks = malloc(capacity * sizeof(pthread_mutex_t));
    if (!ht->buckets || !ht->bucket_locks) {
        free(ht->buckets);
        free(ht->bucket_locks);
        free(ht);
        return NULL;
    }

    for (i = 0; i < capacity; ++i) {
        pthread_mutex_init(&ht->bucket_locks[i], NULL);
    }

    atomic_init(&ht->size, 0);
    atomic_init(&ht->collisions, 0);
    return ht;
}

bool ht_insert(ConcurrentChainingHashTable *ht, const char *key, int value) {
    size_t idx = hash_str(key, ht->capacity);
    Node *curr;
    Node *new_node;

    /* Bloqueamos únicamente la cubeta afectada */
    pthread_mutex_lock(&ht->bucket_locks[idx]);

    curr = ht->buckets[idx];
    while (curr != NULL) {
        if (strcmp(curr->key, key) == 0) {
            curr->value = value; /* Actualización in-place */
            pthread_mutex_unlock(&ht->bucket_locks[idx]);
            return true;
        }
        curr = curr->next;
    }

    /* Si la cubeta ya tenía al menos un elemento, registramos colisión atómica */
    if (ht->buckets[idx] != NULL) {
        atomic_fetch_add_explicit(&ht->collisions, 1, memory_order_relaxed);
    }

    new_node = malloc(sizeof(Node));
    if (!new_node) {
        pthread_mutex_unlock(&ht->bucket_locks[idx]);
        return false;
    }
    new_node->key = strdup(key);
    new_node->value = value;
    new_node->next = ht->buckets[idx];
    ht->buckets[idx] = new_node;

    atomic_fetch_add_explicit(&ht->size, 1, memory_order_relaxed);
    pthread_mutex_unlock(&ht->bucket_locks[idx]);
    return true;
}

bool ht_search(ConcurrentChainingHashTable *ht, const char *key, int *out_value) {
    size_t idx = hash_str(key, ht->capacity);
    Node *curr;

    pthread_mutex_lock(&ht->bucket_locks[idx]);
    curr = ht->buckets[idx];
    while (curr != NULL) {
        if (strcmp(curr->key, key) == 0) {
            if (out_value) *out_value = curr->value;
            pthread_mutex_unlock(&ht->bucket_locks[idx]);
            return true;
        }
        curr = curr->next;
    }
    pthread_mutex_unlock(&ht->bucket_locks[idx]);
    return false;
}

bool ht_delete(ConcurrentChainingHashTable *ht, const char *key) {
    size_t idx = hash_str(key, ht->capacity);
    Node **indirect;
    Node *entry;

    pthread_mutex_lock(&ht->bucket_locks[idx]);
    indirect = &ht->buckets[idx]; /* Puntero doble para borrado limpio */
    while (*indirect != NULL) {
        entry = *indirect;
        if (strcmp(entry->key, key) == 0) {
            *indirect = entry->next;
            free(entry->key);
            free(entry);
            atomic_fetch_sub_explicit(&ht->size, 1, memory_order_relaxed);
            pthread_mutex_unlock(&ht->bucket_locks[idx]);
            return true;
        }
        indirect = &entry->next;
    }
    pthread_mutex_unlock(&ht->bucket_locks[idx]);
    return false;
}

void ht_destroy(ConcurrentChainingHashTable *ht) {
    size_t i;
    Node *curr;
    Node *tmp;

    if (!ht) return;
    for (i = 0; i < ht->capacity; ++i) {
        pthread_mutex_lock(&ht->bucket_locks[i]);
        curr = ht->buckets[i];
        while (curr != NULL) {
            tmp = curr;
            curr = curr->next;
            free(tmp->key);
            free(tmp);
        }
        pthread_mutex_unlock(&ht->bucket_locks[i]);
        pthread_mutex_destroy(&ht->bucket_locks[i]);
    }
    free(ht->buckets);
    free(ht->bucket_locks);
    free(ht);
}

/* Simulación multihilo concurrente */
typedef struct {
    ConcurrentChainingHashTable *ht;
    int thread_id;
    int items_per_thread;
} ThreadArg;

void *worker_routine(void *arg) {
    ThreadArg *targ = (ThreadArg *)arg;
    char key_buf[64];
    int i;

    for (i = 0; i < targ->items_per_thread; ++i) {
        snprintf(key_buf, sizeof(key_buf), "T%d_clave_%d", targ->thread_id, i);
        ht_insert(targ->ht, key_buf, targ->thread_id * 1000 + i);
    }
    return NULL;
}

#define CAP 31
#define NUM_THREADS 4
#define ITEMS 25

int main(void) {
    ConcurrentChainingHashTable *ht;
    pthread_t threads[NUM_THREADS];
    ThreadArg args[NUM_THREADS];
    int t;
    int val = 0;

    ht = ht_create(CAP);

    for (t = 0; t < NUM_THREADS; ++t) {
        args[t].ht = ht;
        args[t].thread_id = t;
        args[t].items_per_thread = ITEMS;
        pthread_create(&threads[t], NULL, worker_routine, &args[t]);
    }
    for (t = 0; t < NUM_THREADS; ++t) {
        pthread_join(threads[t], NULL);
    }

    printf("=== ENCADENAMIENTO SEPARADO CONCURRENTE (C11 + PTHREADS) ===\n");
    printf("Elementos insertados (atomic size): %zu\n", atomic_load(&ht->size));
    printf("Colisiones registradas (atomic):    %zu\n", atomic_load(&ht->collisions));

    if (ht_search(ht, "T2_clave_14", &val)) {
        printf("Busqueda 'T2_clave_14' -> Encontrada, valor = %d\n", val);
    }
    ht_delete(ht, "T2_clave_14");
    printf("Tras eliminar 'T2_clave_14', nuevo size = %zu\n", atomic_load(&ht->size));

    ht_destroy(ht);
    return 0;
}
